# Optional Bedrock mode. Leave FIREMIND_BEDROCK_MODEL_ID blank for local fallback mode.
AWS_REGION=us-east-1
FIREMIND_BEDROCK_MODEL_ID=
FIREMIND_ALLOWED_ORIGIN=*
FIREMIND_HOST=127.0.0.1
FIREMIND_PORT=8080
# Supply AWS credentials through the AWS CLI profile, IAM role, or runtime environment.
# Never commit credentials here.
